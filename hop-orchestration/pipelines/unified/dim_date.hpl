<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>dim_date</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Load unified date dimension dynamically from replicated source dates</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/11/09 00:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/11/09 00:00:00.000</modified_date>
  </info>

  <notepads>
  </notepads>

  <order>
    <hop>
      <from>Generate Calendar Dates</from>
      <to>Insert Missing Dates</to>
      <enabled>Y</enabled>
    </hop>
  </order>

  <transform>
    <name>Generate Calendar Dates</name>
    <type>TableInput</type>
    <description>Generate date records from replicated source data with one-year future buffer</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>MYSQL_REPLICATED</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>WITH source_dates AS (
    SELECT DATE(created_date) AS dt FROM cardholders
    UNION ALL
    SELECT issue_date FROM cards
    UNION ALL
    SELECT transaction_date FROM transactions
    UNION ALL
    SELECT start_date FROM offers
    UNION ALL
    SELECT end_date FROM offers
    UNION ALL
    SELECT start_date FROM campaigns
    UNION ALL
    SELECT end_date FROM campaigns
    UNION ALL
    SELECT processed_date FROM reward_points
),
bounds AS (
    SELECT
        MIN(dt) AS start_date,
        DATE_ADD(MAX(dt), INTERVAL 1 YEAR) AS end_date
    FROM source_dates
    WHERE dt IS NOT NULL
),
digits AS (
    SELECT 0 AS n UNION ALL SELECT 1 UNION ALL
    SELECT 2 UNION ALL SELECT 3 UNION ALL
    SELECT 4 UNION ALL SELECT 5 UNION ALL
    SELECT 6 UNION ALL SELECT 7 UNION ALL
    SELECT 8 UNION ALL SELECT 9
),
numbers AS (
    SELECT
        d1.n + (d2.n * 10) + (d3.n * 100) + (d4.n * 1000) AS seq
    FROM digits d1
    CROSS JOIN digits d2
    CROSS JOIN digits d3
    CROSS JOIN digits d4
),
calendar_dates AS (
    SELECT
        DATE_ADD(b.start_date, INTERVAL n.seq DAY) AS full_date
    FROM bounds b
    CROSS JOIN numbers n
    WHERE n.seq &lt;= DATEDIFF(b.end_date, b.start_date)
)
SELECT
    CAST(DATE_FORMAT(c.full_date, '%Y%m%d') AS UNSIGNED) AS date_key,
    c.full_date AS full_date,
    DAYOFMONTH(c.full_date) AS day_number,
    MONTH(c.full_date) AS month_number,
    MONTHNAME(c.full_date) AS month_name,
    QUARTER(c.full_date) AS quarter_number,
    YEAR(c.full_date) AS year_number,
    DAYNAME(c.full_date) AS weekday_name,
    CASE
        WHEN DAYOFWEEK(c.full_date) IN (1, 7) THEN 'Y'
        ELSE 'N'
    END AS weekend_flag
FROM calendar_dates c
WHERE NOT EXISTS (
    SELECT 1
    FROM bpaydb_unified_dev.dim_date existing
    WHERE existing.date_key =
          CAST(DATE_FORMAT(c.full_date, '%Y%m%d') AS UNSIGNED)
)
ORDER BY c.full_date;</sql>
    <variables_active>N</variables_active>
    <attributes/>
    <GUI>
      <xloc>160</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>

  <transform>
    <name>Insert Missing Dates</name>
    <type>TableOutput</type>
    <description>Insert generated dates into unified dimension</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>1000</commit>
    <connection>MYSQL_UNIFIED</connection>
    <fields>
    </fields>
    <ignore_errors>N</ignore_errors>
    <only_when_have_rows>N</only_when_have_rows>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_monthly>N</partitioning_monthly>
    <return_keys>N</return_keys>
    <specify_fields>N</specify_fields>
    <table>dim_date</table>
    <tablename_in_field>N</tablename_in_field>
    <tablename_in_table>Y</tablename_in_table>
    <truncate>N</truncate>
    <use_batch>Y</use_batch>
    <attributes/>
    <GUI>
      <xloc>480</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>

  <transform_error_handling>
  </transform_error_handling>

  <attributes/>
</pipeline>