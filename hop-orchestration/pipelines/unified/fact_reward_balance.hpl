<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>fact_reward_balance</name>
    <name_in_metrics>fact_reward_balance</name_in_metrics>
    <description>Load customer daily reward balance snapshots</description>
    <extended_description/>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_version/>
    <pipeline_status>0</pipeline_status>
    <directory>/</directory>
    <parameters/>
    <log/>
    <maxdate>2026/11/09 00:00:00.000</maxdate>
    <size_rowset>10000</size_rowset>
    <sleep_time_empty>50</sleep_time_empty>
    <sleep_time_full>50</sleep_time_full>
    <unique_connections>N</unique_connections>
    <feedback_shown>Y</feedback_shown>
    <feedback_size>50000</feedback_size>
    <using_thread_priorities>Y</using_thread_priorities>
    <shared_objects_file/>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user/>
    <created_date>2026/11/09 00:00:00.000</created_date>
    <modified_user/>
    <modified_date>2026/11/09 00:00:00.000</modified_date>
    <key_for_session_key/>
  </info>

  <order>
    <hop>
      <from>Read New Reward Balances</from>
      <to>Insert Reward Balances</to>
      <enabled>Y</enabled>
    </hop>
  </order>

  <notepads/>

  <transform>
    <name>Read New Reward Balances</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>MYSQL_REPLICATED</connection>
    <sql>SELECT
    dc.customer_key,
    dd.date_key,
    rp.earned_points,
    rp.redeemed_points,
    rp.available_points
FROM reward_points rp
INNER JOIN transactions t
    ON t.transaction_id = rp.transaction_id
INNER JOIN cards c
    ON c.card_id = t.card_id
INNER JOIN bpaydb_unified_dev.dim_customer dc
    ON dc.cardholder_id = c.cardholder_id
   AND dc.current_flag = 'Y'
INNER JOIN bpaydb_unified_dev.dim_date dd
    ON dd.full_date = rp.processed_date
WHERE NOT EXISTS (
    SELECT 1
    FROM bpaydb_unified_dev.fact_reward_balance fb
    WHERE fb.customer_key = dc.customer_key
      AND fb.date_key = dd.date_key
)
ORDER BY dc.customer_key, dd.date_key;</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cached_row_meta/>
    <remotesteps>
      <input>
        <name/>
        <server/>
        <source_transform/>
        <source_step/>
        <type>none</type>
      </input>
      <output>
        <name/>
        <server/>
        <target_transform/>
        <target_step/>
        <type>none</type>
      </output>
    </remotesteps>
    <GUI>
      <xloc>160</xloc>
      <yloc>160</yloc>
      <draw>Y</draw>
    </GUI>
  </transform>

  <transform>
    <name>Insert Reward Balances</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>MYSQL_UNIFIED</connection>
    <schema/>
    <table>fact_reward_balance</table>
    <commit>1000</commit>
    <truncate>N</truncate>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>Y</specify_fields>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field/>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <tablename_in_table>N</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field/>
    <fields>
      <field>
        <column_name>customer_key</column_name>
        <stream_name>customer_key</stream_name>
      </field>
      <field>
        <column_name>date_key</column_name>
        <stream_name>date_key</stream_name>
      </field>
      <field>
        <column_name>earned_points</column_name>
        <stream_name>earned_points</stream_name>
      </field>
      <field>
        <column_name>redeemed_points</column_name>
        <stream_name>redeemed_points</stream_name>
      </field>
      <field>
        <column_name>available_points</column_name>
        <stream_name>available_points</stream_name>
      </field>
    </fields>
    <remotesteps>
      <input>
        <name/>
        <server/>
        <source_transform/>
        <source_step/>
        <type>none</type>
      </input>
      <output>
        <name/>
        <server/>
        <target_transform/>
        <target_step/>
        <type>none</type>
      </output>
    </remotesteps>
    <GUI>
      <xloc>480</xloc>
      <yloc>160</yloc>
      <draw>Y</draw>
    </GUI>
  </transform>

  <step_error_handling/>
  <slave-step-copy-partition-distribution/>
  <slave_transformation>N</slave_transformation>
  <attributes/>
</pipeline>