<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>fact_campaign_performance</name>
    <name_in_metrics>fact_campaign_performance</name_in_metrics>
    <description>Load daily campaign performance aggregates</description>
    <extended_description/>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_version/>
    <pipeline_status>0</pipeline_status>
    <directory>/</directory>
    <parameters/>
    <log/>
    <size_rowset>10000</size_rowset>
    <sleep_time_empty>50</sleep_time_empty>
    <sleep_time_full>50</sleep_time_full>
    <unique_connections>N</unique_connections>
    <feedback_shown>Y</feedback_shown>
    <feedback_size>50000</feedback_size>
    <using_thread_priorities>Y</using_thread_priorities>
    <shared_objects_file/>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user/>
    <created_date>2026/11/09 00:00:00.000</created_date>
    <modified_user/>
    <modified_date>2026/11/09 00:00:00.000</modified_date>
    <key_for_session_key/>
  </info>

  <order>
    <hop>
      <from>Read New Campaign Performance</from>
      <to>Insert Campaign Performance</to>
      <enabled>Y</enabled>
    </hop>
  </order>

  <notepads/>

  <transform>
    <name>Read New Campaign Performance</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>MYSQL_REPLICATED</connection>
    <sql>SELECT
    dc.campaign_key,
    dd.date_key,
    COUNT(DISTINCT t.transaction_id) AS transaction_count,
    SUM(t.transaction_amount) AS total_sales,
    SUM(COALESCE(rp.earned_points, 0)) AS reward_points,
    COUNT(DISTINCT c.cardholder_id) AS participating_customers
FROM transactions t
INNER JOIN cards c
    ON c.card_id = t.card_id
LEFT JOIN reward_points rp
    ON rp.transaction_id = t.transaction_id
INNER JOIN bpaydb_unified_dev.dim_campaign dc
    ON dc.campaign_id = t.campaign_id
INNER JOIN bpaydb_unified_dev.dim_date dd
    ON dd.full_date = t.transaction_date
WHERE t.campaign_id IS NOT NULL
  AND NOT EXISTS (
      SELECT 1
      FROM bpaydb_unified_dev.fact_campaign_performance fp
      WHERE fp.campaign_key = dc.campaign_key
        AND fp.date_key = dd.date_key
  )
GROUP BY
    dc.campaign_key,
    dd.date_key
ORDER BY
    dc.campaign_key,
    dd.date_key;</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cached_row_meta/>
    <GUI>
      <xloc>160</xloc>
      <yloc>160</yloc>
      <draw>Y</draw>
    </GUI>
  </transform>

  <transform>
    <name>Insert Campaign Performance</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>MYSQL_UNIFIED</connection>
    <schema/>
    <table>fact_campaign_performance</table>
    <commit>1000</commit>
    <truncate>N</truncate>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>Y</specify_fields>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field/>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <tablename_in_table>N</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field/>
    <fields>
      <field>
        <column_name>campaign_key</column_name>
        <stream_name>campaign_key</stream_name>
      </field>
      <field>
        <column_name>date_key</column_name>
        <stream_name>date_key</stream_name>
      </field>
      <field>
        <column_name>transaction_count</column_name>
        <stream_name>transaction_count</stream_name>
      </field>
      <field>
        <column_name>total_sales</column_name>
        <stream_name>total_sales</stream_name>
      </field>
      <field>
        <column_name>reward_points</column_name>
        <stream_name>reward_points</stream_name>
      </field>
      <field>
        <column_name>participating_customers</column_name>
        <stream_name>participating_customers</stream_name>
      </field>
    </fields>
    <GUI>
      <xloc>480</xloc>
      <yloc>160</yloc>
      <draw>Y</draw>
    </GUI>
  </transform>

  <step_error_handling/>
  <slave-step-copy-partition-distribution/>
  <slave_transformation>N</slave_transformation>
  <attributes/>
</pipeline>