<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>dim_card</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Load unified card dimension with customer surrogate key lookup</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters></parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/11/09 00:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/11/09 00:00:00.000</modified_date>
  </info>
  <notepads></notepads>
  <order>
    <hop>
      <from>Read New Cards</from>
      <to>Insert Cards</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Read New Cards</name>
    <type>TableInput</type>
    <description>Read replicated cards and resolve current customer surrogate keys</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>MYSQL_REPLICATED</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>SELECT
    c.card_id,
    d.customer_key,
    c.card_number,
    c.card_type,
    c.issuer,
    c.credit_limit,
    c.card_status,
    c.issue_date
FROM bpaydb_replicated_dev.cards c
INNER JOIN bpaydb_unified_dev.dim_customer d
    ON d.cardholder_id = c.cardholder_id
   AND d.current_flag = 'Y'
WHERE NOT EXISTS (
    SELECT 1
    FROM bpaydb_unified_dev.dim_card existing
    WHERE existing.card_id = c.card_id
)
ORDER BY c.card_id;</sql>
    <variables_active>N</variables_active>
    <attributes/>
    <GUI>
      <xloc>160</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Insert Cards</name>
    <type>TableOutput</type>
    <description>Insert new cards into unified dimension</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>1000</commit>
    <connection>MYSQL_UNIFIED</connection>
    <fields></fields>
    <ignore_errors>N</ignore_errors>
    <only_when_have_rows>N</only_when_have_rows>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_monthly>N</partitioning_monthly>
    <return_keys>N</return_keys>
    <specify_fields>N</specify_fields>
    <table>dim_card</table>
    <tablename_in_field>N</tablename_in_field>
    <tablename_in_table>Y</tablename_in_table>
    <truncate>N</truncate>
    <use_batch>Y</use_batch>
    <attributes/>
    <GUI>
      <xloc>480</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform_error_handling></transform_error_handling>
  <attributes/>
</pipeline>